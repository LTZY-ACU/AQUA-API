# AQUA-API 环境变量样例
#
# 用法：cp .env.example .env 后填入真实值，再把 .env 交给 Docker Compose 或 systemd 的 EnvironmentFile。
#
# 铁律：真实密钥只放这里（或服务器上的 /etc/aqua/aqua.env），
#      **永远不要提交进仓库**，也不要写进配置文件（配置文件里的密钥字段会被程序忽略）。

# ── 必填 ────────────────────────────────────────────────
# 加密主密钥，用于加解密渠道密钥。生成：./aqua -gen-key
# 注意：一旦更换，已加密的上游密钥将无法解密 —— 请单独备份。
AQUA_APP_KEY=

# ── 服务 ────────────────────────────────────────────────
# 容器内必须是 0.0.0.0；裸机部署建议保持 127.0.0.1 并交给 Nginx 反代
AQUA_SERVER_LISTEN=0.0.0.0:8787
AQUA_SERVER_MODE=release

# ── 数据库 ──────────────────────────────────────────────
AQUA_DATABASE_DRIVER=sqlite
# 下面的绝对路径只适用于 Docker Compose（容器内数据卷固定 /data，见 docker-compose.yml）。
# 裸机/systemd 部署请【删掉本行】：服务以 aqua 用户运行，无法在 / 下创建目录，
# 会启动失败；删除后走默认值 ./data/aqua.db，与 aqua-api.service 的
# WorkingDirectory=/var/lib/aqua 正好匹配。
AQUA_DATABASE_DSN=/data/aqua.db

# ── 日志 ────────────────────────────────────────────────
AQUA_LOG_LEVEL=info
AQUA_LOG_FORMAT=text

# ── 网关默认分组 ────────────────────────────────────────
# 决定"不带分组的令牌"走哪个分组的渠道与计费；改这里通常要和渠道的所属分组保持一致
AQUA_RELAY_GROUP=default

# ── 邮件（可选，用于注册验证码与通知）──────────────────
AQUA_SMTP_HOST=
AQUA_SMTP_PORT=465
AQUA_SMTP_USERNAME=
AQUA_SMTP_PASSWORD=
AQUA_SMTP_FROM=
AQUA_SMTP_FROM_NAME=AQUA-API

# ── 支付通道（可选，全部只走环境变量）──────────────────
# 易支付：网关地址 / 商户号在后台填写，密钥只放这里
AQUA_EPAY_KEY=
# Stripe
AQUA_STRIPE_SECRET_KEY=
AQUA_STRIPE_WEBHOOK_SECRET=
# 支付宝（应用私钥 + 支付宝公钥，支持 PEM 与裸 base64 两种形态）
AQUA_ALIPAY_PRIVATE_KEY=
AQUA_ALIPAY_PUBLIC_KEY=
# 微信支付 APIv3
AQUA_WECHATPAY_APIV3_KEY=
AQUA_WECHATPAY_PRIVATE_KEY=
AQUA_WECHATPAY_PLATFORM_PUBLIC_KEY=

# ── 数据保留期（可选，单位：天；0 = 该表不清理）────────────
# 这些表只写不删，到保留期后由后台每小时清理一次（删除条数会打进日志）。
# 需要永久留痕（如法务要求）的项设为 0 即可关闭。
AQUA_RETENTION_USAGE_LOG_DAYS=180
AQUA_RETENTION_AUDIT_LOG_DAYS=365
AQUA_RETENTION_QUOTA_RESERVATION_DAYS=7
AQUA_RETENTION_CORPUS_SAMPLE_DAYS=30
AQUA_RETENTION_BROADCAST_DAYS=90

# ── 渠道健康巡检（可选，默认开启）────────────────────────────
# 后台周期性对每个启用中的渠道发一次最小请求，自动刷新它的延迟、状态码与可用模型。
# 关掉后后台渠道列表里的延迟将停止更新（只剩手动「测活」会被记录）。
# 开关认 true/1/yes/on 与 false/0/no/off（大小写不敏感），其它写法按默认值处理。
AQUA_HEALTH_ENABLED=true
# 相邻两轮巡检的间隔（分钟；<=0 回退到 15）
AQUA_HEALTH_INTERVAL_MINUTES=15
# 单轮内同时探测的渠道数（<=0 回退到 2；不要把巡检变成对上游的并发压测）
AQUA_HEALTH_CONCURRENCY=2
# 单个渠道的最长等待时间（秒；<=0 回退到 30；远比转发链路的 300 秒短，
# 因为"等 30 秒还没回来"本身就说明这条链路不可用）
AQUA_HEALTH_TIMEOUT_SECONDS=30

# ── QIU 科技账号登录（可选，默认开启）──────────────────────────
# 用户可在登录页选择"使用 QIU 科技账号登录"：本站不接触对方口令，
# 只拿对方的 user.id 与本站账号做绑定（绑定关系落在 user_external_accounts 表）。
# 关掉后登录页不再请求该入口（未开放时接口返回 404）。
AQUA_QIU_ENABLED=true
# 对方开放接口的根地址（换域名时改这里即可，无需重新发版）
AQUA_QIU_BASE_URL=https://qiukeji.jghuihui.top
# 展示在对方确认页上的身份名称；留空则回退到站点名称
AQUA_QIU_APP_NAME=
# 调用对方接口的超时秒数（<=0 回退到 10）
AQUA_QIU_TIMEOUT_SECONDS=10

# ── Prometheus 指标端点（可选，默认开启）──────────────────────
# GET /metrics 输出 Prometheus 文本协议（请求量/状态码分布/延迟分位/在途数/运行时长）。
# 暴露的全是聚合值，不含用户身份、密钥与请求内容；标签只用路由模板，
# 不含 URL 里的 ID，因此不会泄露用户数据（运营规模仍属敏感信息）。
AQUA_METRICS_ENABLED=true
# 访问令牌：留空 = 不鉴权（适合内网与本机采集）；
# 公网部署若不希望任何人探到，设一个值，采集侧配 Authorization: Bearer <token>。
AQUA_METRICS_TOKEN=
